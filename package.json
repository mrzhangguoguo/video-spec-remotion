{
  "name": "video-spec-remotion",
  "version": "0.1.0",
  "description": "Video Spec Builder for Remotion — 从分镜脚本到视频",
  "scripts": {
    "preview": "remotion studio",
    "render": "remotion render src/compositions/VideoFromSpec.tsx out/video.mp4",
    "render:gif": "remotion render src/compositions/VideoFromSpec.tsx out/video.gif --image-format=png",
    "generate": "npx tsx scripts/generate-composition.ts",
    "build": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "remotion": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/plot": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "@remotion/motion-blur": "^4.0.0",
    "@remotion/lottie": "^4.0.0",
    "@remotion/media-utils": "^4.0.0",
    "@remotion/captions": "^4.0.0",
    "@remotion/noise": "^4.0.0",
    "@remotion/shader": "^4.0.0",
    "@remotion/three": "^4.0.0",
    "@xyflow/react": "^12.0.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "prism-react-renderer": "^2.3.0",
    "recharts": "^2.12.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.0"
  }
}
